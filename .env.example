# Production / local example environment variables

# Backend
GOOGLE_CLIENT_ID=your-google-oauth-2-0-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-app.example.com/auth/google/callback
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db>?retryWrites=true&w=majority
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-google-project-id
GCLOUD_PROJECT=your-google-project-id
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_CLOUD_KEYFILE_JSON='{"type":"service_account",...}'
USE_LOCAL_OBJECT_STORAGE=false
LOG_LEVEL=info

# Frontend
VITE_GOOGLE_CLIENT_ID=your-google-oauth-2-0-client-id
